generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dealer {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  email     String?
  phone     String?
  address   String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  cars  Car[]
  leads Lead[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  dealerId     String
  dealer       Dealer   @relation(fields: [dealerId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Car {
  id                 String        @id @default(cuid())
  dealerId           String
  dealer             Dealer        @relation(fields: [dealerId], references: [id])

  make               String
  model              String
  variant            String?
  year               Int
  price              Int
  mileage            Int
  registration       String?
  registrationPublic Boolean       @default(false)
  vin                String?
  fuel               String
  transmission       String
  horsepower         Int?
  color              String?

  description        String        @default("")
  equipment          String        @default("[]")

  status             String        @default("DRAFT")
  slug               String        @unique

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  publishedAt        DateTime?
  soldAt             DateTime?

  images             CarImage[]
  leads              Lead[]

  @@index([status])
  @@index([make, model])
}

model CarImage {
  id        String   @id @default(cuid())
  carId     String
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Lead {
  id        String   @id @default(cuid())
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id])
  carId     String?
  car       Car?     @relation(fields: [carId], references: [id])
  type      String   @default("GENERAL")
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
}